{
  "name": "sanad-server",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "a server to connect the rosbridge websocket to the outer system components",
  "main": "src/index.js",
  "imports": {
    "#utils/*": "./src/utils/*",
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*",
    "#modules/*": "./src/api/v1/*",
    "#servers/*": "./src/servers/*",
    "#db/*": "./src/db"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "dev:smart-home:frontend": "cd ./src/api/v1/smart-home/testing/frontend && npm run dev",
    "dev:smart-home:discovery": "node --watch src/api/v1/smart-home/discovery.udp.js",
    "mock:smart-home": "nodemon src/mocks/smart-home/index.js",
    "test": "NODE_ENV=testing NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest --detectOpenHandles --runInBand --testTimeout=5000",
    "setup:irdb": "git clone --depth=1 https://github.com/UberGuidoZ/Flipper-IRDB ./irdb",
    "update:irdb": "git -C ./irdb pull"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanadChair/server.git"
  },
  "keywords": [
    "sanad",
    "server",
    "rosbridge",
    "roslibjs"
  ],
  "author": "OmarKHDR",
  "bugs": {
    "url": "https://github.com/sanadChair/server/issues"
  },
  "homepage": "https://github.com/sanadChair/server#readme",
  "dependencies": {
    "better-sql": "^1.0.5",
    "broadcast-address": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mqtt": "^5.15.0",
    "reflect-metadata": "^0.2.2",
    "roslib": "^1.4.1",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "telegram": "^2.26.22",
    "typeorm": "^0.3.29",
    "winston": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "nodemonConfig": {
    "ignore": [
      "src/mocks/smart-home/smart-dev.json",
      "src/api/v1/smart-home/smart-home.db.json"
    ]
  }
}
