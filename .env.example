#=========================#
#=======BROADCAST=========#
#=========================#
BROADCAST_PORT=9988


#=========================#
#=======BROADCAST=========#
#======smartDevice========#
#=========================#
SMART_DEV_PORT=80


#=========================#
#=====exposed server======#
#=========================#
SERVER_HOSTNAME=0.0.0.0
SERVER_PORT=5051

#=========================#
#===internal ros bridge===#
#=========================#
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

#=========================#
#=======Time Zones========#
#=========================#
TZ='Africa/Cairo'
LOCALE='en-GB'


#=========================#
#========Telegram=========#
#=========================#
# go to https://my.telegram.org/apps 
# then sign in with telegram number to create a developer app id, and hash
API_ID='3760xxxx'
API_HASH='136de33xxxxxxxxxxxxxxxxxxxxxxxxx'


#=========================#
#=====Wi-Fi Provisioning==#
#=========================#
# Dedicated secondary Wi-Fi interface for ESP32 provisioning (e.g. wlan1 on Linux)
PROVISIONING_INTERFACE=wlan1
# Secret salt for HMAC-SHA256 password derivation — KEEP SECRET
PROVISIONING_SALT=change-this-to-a-strong-random-secret
# Home router credentials pushed to new ESP32 devices
HOME_WIFI_SSID=YourHomeNetworkSSID
HOME_WIFI_PASSWORD=YourHomeNetworkPassword
# How often the background scanner checks for new SoftAP devices (ms)
PROVISIONING_SCAN_INTERVAL_MS=15000
# Set to 'true' to bypass real Wi-Fi commands and inject a mock device
MOCK_MODE=false
